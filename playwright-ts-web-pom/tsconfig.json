{
    "compilerOptions": {
        "target": "ESNext",
        "module": "commonjs",
        "lib": [
            "ESNext"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "outDir": "./dist",
        "rootDir": "./",
        "types": [
            "node",
            "@playwright/test"
        ],
        "baseUrl": "src",
        "paths": {
            "@config/*": [
                "config/*"
            ],
            "@data/*": [
                "data/*"
            ],
            "@fixtures/*": [
                "fixtures/*"
            ],
            "@pages/*": [
                "pages/*"
            ],
            "@tests/*": [
                "tests/*"
            ]
        }
    },
    "include": [
        "src/**/*.ts",
        "utility/**/*.ts",
        "playwright.config.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}